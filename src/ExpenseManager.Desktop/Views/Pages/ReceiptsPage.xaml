<UserControl x:Class="ExpenseManager.Desktop.Views.Pages.ReceiptsPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ExpenseManager.Desktop.ViewModels"
             xmlns:items="clr-namespace:ExpenseManager.Desktop.ViewModels.Items"
             xmlns:extensions="clr-namespace:ExpenseManager.Desktop.Extensions"
             xmlns:converters="clr-namespace:ExpenseManager.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReceiptsViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="32,32,16,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{extensions:TranslateExtension SECTION_RECEIPTS_LIST}"
                           Style="{StaticResource SubheadingText}" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                    <Button Content="{extensions:TranslateExtension ACTION_NEW_RECEIPT}"
                            Command="{Binding NewReceiptCommand}"
                            Style="{StaticResource AccentButton}" />
            <Button Content="{extensions:TranslateExtension ACTION_EDIT_SELECTED}"
                Command="{Binding EditReceiptCommand}"
                Style="{StaticResource SidebarLinkButton}"
                Margin="12,0,0,0" />
            <Button Content="{extensions:TranslateExtension ACTION_DELETE_SELECTED}"
                Command="{Binding DeleteReceiptCommand}"
                Style="{StaticResource SidebarLinkButton}"
                Margin="12,0,0,0" />
            <Button Content="{extensions:TranslateExtension ACTION_REFRESH}"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource SidebarLinkButton}"
                Margin="12,0,0,0" />
                </StackPanel>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding Receipts}"
                          SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}"
                          Margin="0,0,0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type items:ReceiptListItemViewModel}">
                            <Border Background="{DynamicResource ListItemBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CategoryDisplay}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding AmountDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding DateDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Vendor}" Visibility="{Binding Vendor, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                                        <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Visibility="{Binding ReferenceNumber, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding ReferenceNumber}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CommissionDisplay}" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Visibility="{Binding CommissionDisplay, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,32,32,32"
                Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{extensions:TranslateExtension SECTION_RECEIPTS_FORM}"
                               Style="{StaticResource SubheadingText}" />

                    <TextBlock Text="{extensions:TranslateExtension LABEL_TITLE}" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBox Text="{Binding TitleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{extensions:TranslateExtension LABEL_RECEIPT_DATE}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <DatePicker SelectedDate="{Binding ReceiptDate, Mode=TwoWay}" CalendarStyle="{StaticResource ThemedCalendar}" />

                    <TextBlock Text="{extensions:TranslateExtension LABEL_NET_AMOUNT}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="160" Text="{Binding AmountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox ItemsSource="{Binding CurrencyValues}" SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                                  Width="140" Margin="12,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{extensions:TranslateExtension LABEL_COMMISSION_PERCENT}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="160" Text="{Binding CommissionPercentInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <TextBlock Text="{extensions:TranslateExtension LABEL_RECEIPT_CATEGORY}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" DisplayMemberPath="DisplayName" />

                    <TextBlock Text="{extensions:TranslateExtension LABEL_VENDOR}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <TextBox Text="{Binding VendorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{extensions:TranslateExtension LABEL_REFERENCE_NUMBER}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <TextBox Text="{Binding ReferenceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{extensions:TranslateExtension LABEL_DESCRIPTION}" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <TextBox Text="{Binding DescriptionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />

            <TextBlock Text="{extensions:TranslateExtension LABEL_RECEIPT_DOCUMENT}" FontWeight="SemiBold" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
            <Button Content="{extensions:TranslateExtension ACTION_ATTACH_DOCUMENT}"
                Command="{Binding AttachDocumentCommand}"
                Style="{StaticResource SidebarLinkButton}" />
            <Button Content="{extensions:TranslateExtension ACTION_OPEN}"
                Command="{Binding OpenAttachmentCommand}"
                Style="{StaticResource SidebarLinkButton}"
                Margin="12,0,0,0"
                Visibility="{Binding HasAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="{extensions:TranslateExtension ACTION_REMOVE}"
                Command="{Binding ClearAttachmentCommand}"
                Style="{StaticResource SidebarLinkButton}"
                Margin="12,0,0,0"
                Visibility="{Binding HasAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <TextBlock Text="{Binding AttachmentSummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="{extensions:TranslateExtension ACTION_SAVE}"
                Command="{Binding SaveReceiptCommand}"
                Style="{StaticResource AccentButton}" />
            <Button Content="{extensions:TranslateExtension ACTION_CANCEL}"
                Command="{Binding CancelEditCommand}"
                Style="{StaticResource SidebarLinkButton}"
                Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

    <Border Grid.Column="0" Background="{DynamicResource OverlayBrush}"
        Grid.ColumnSpan="2"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" Padding="24" CornerRadius="12">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                    <TextBlock Text="{extensions:TranslateExtension STATUS_LOADING_RECEIPTS}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

    <Border Grid.Column="0" Background="{DynamicResource OverlayBrush}"
        Grid.ColumnSpan="2"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" Padding="24" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="{extensions:TranslateExtension ERROR_DATA_LOAD}" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
