<UserControl x:Class="ExpenseManager.Desktop.Views.Pages.ConnectionsPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ExpenseManager.Desktop.ViewModels"
             xmlns:items="clr-namespace:ExpenseManager.Desktop.ViewModels.Items"
             xmlns:extensions="clr-namespace:ExpenseManager.Desktop.Extensions"
             xmlns:converters="clr-namespace:ExpenseManager.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionsViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        <ItemsPanelTemplate x:Key="SummaryItemsPanel">
            <UniformGrid Columns="4" />
        </ItemsPanelTemplate>
        <DataTemplate DataType="{x:Type items:LinkSummaryItemViewModel}" x:Key="SummaryItemTemplate">
            <Border Background="{DynamicResource ListItemBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CategoryDisplay}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding DateDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding LinkCountDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExtraDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"
                               Visibility="{Binding ExtraDisplay, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type items:ConnectionDetailItemViewModel}" x:Key="DetailItemTemplate">
            <Border Background="{DynamicResource ListItemBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding ReceiptTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ExpenseTitle}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding Notes, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{extensions:TranslateExtension LABEL_CREATED}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text=":" Margin="4,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding CreatedAtLocal, StringFormat='{}{0:G}'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdatedAtLocal}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{extensions:TranslateExtension LABEL_UPDATED}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text=":" Margin="4,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding UpdatedAtLocal, StringFormat='{}{0:G}'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding SummaryCards}" ItemsPanel="{StaticResource SummaryItemsPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SummaryCardItemViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{extensions:TranslateExtension LABEL_FROM_DATE}" Style="{StaticResource MutedText}" />
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" CalendarStyle="{StaticResource ThemedCalendar}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{extensions:TranslateExtension LABEL_TO_DATE}" Style="{StaticResource MutedText}" />
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" CalendarStyle="{StaticResource ThemedCalendar}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <CheckBox Content="{extensions:TranslateExtension LABEL_ONLY_OPEN_EXPENSES}" IsChecked="{Binding OnlyOpenExpenses}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,16,0">
                            <TextBlock Text="{extensions:TranslateExtension LABEL_EXPENSE_CATEGORY}" Style="{StaticResource MutedText}" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding ExpenseCategories}" SelectedItem="{Binding SelectedExpenseCategory, Mode=TwoWay}" DisplayMemberPath="DisplayName" Width="220" />
                                <Button Content="{extensions:TranslateExtension ACTION_ADD}" Style="{StaticResource SidebarLinkButton}" Margin="8,0,0,0" Command="{Binding ShowAddExpenseCategoryCommand}" />
                                <!-- Hide button shown only when the add form is visible -->
                                <Button Content="{extensions:TranslateExtension ACTION_HIDE}" Style="{StaticResource SidebarLinkButton}" Margin="8,0,0,0" Command="{Binding CancelAddExpenseCategoryCommand}" Visibility="{Binding IsAddExpenseCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <Border Background="Transparent" Visibility="{Binding IsAddExpenseCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{extensions:TranslateExtension LABEL_NAME}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding NewExpenseCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{extensions:TranslateExtension LABEL_DESCRIPTION}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding NewExpenseCategoryDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="{extensions:TranslateExtension ACTION_SAVE}" Style="{StaticResource AccentButton}" Command="{Binding SaveNewExpenseCategoryCommand}" />
                                            <Button Content="{extensions:TranslateExtension ACTION_CANCEL}" Style="{StaticResource SidebarLinkButton}" Command="{Binding CancelAddExpenseCategoryCommand}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                         </StackPanel>

                         <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,16,0">
                             <TextBlock Text="{extensions:TranslateExtension LABEL_RECEIPT_CATEGORY}" Style="{StaticResource MutedText}" />
                             <StackPanel Orientation="Horizontal">
                                 <ComboBox ItemsSource="{Binding ReceiptCategories}" SelectedItem="{Binding SelectedReceiptCategory, Mode=TwoWay}" DisplayMemberPath="DisplayName" Width="220" />
                                 <Button Content="{extensions:TranslateExtension ACTION_ADD}" Style="{StaticResource SidebarLinkButton}" Margin="8,0,0,0" Command="{Binding ShowAddReceiptCategoryCommand}" />
                                 <!-- Hide button for receipt category add form -->
                                 <Button Content="{extensions:TranslateExtension ACTION_HIDE}" Style="{StaticResource SidebarLinkButton}" Margin="8,0,0,0" Command="{Binding CancelAddReceiptCategoryCommand}" Visibility="{Binding IsAddReceiptCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                             </StackPanel>
                            <Border Background="Transparent" Visibility="{Binding IsAddReceiptCategoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{extensions:TranslateExtension LABEL_NAME}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding NewReceiptCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{extensions:TranslateExtension LABEL_DESCRIPTION}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding NewReceiptCategoryDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="{extensions:TranslateExtension ACTION_SAVE}" Style="{StaticResource AccentButton}" Command="{Binding SaveNewReceiptCategoryCommand}" />
                                            <Button Content="{extensions:TranslateExtension ACTION_CANCEL}" Style="{StaticResource SidebarLinkButton}" Command="{Binding CancelAddReceiptCategoryCommand}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                         </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,12,0,0">
                            <Button Content="{extensions:TranslateExtension ACTION_APPLY_FILTERS}" Style="{StaticResource AccentButton}" Command="{Binding ApplyFiltersCommand}" Margin="0,0,8,0" />
                            <Button Content="{extensions:TranslateExtension ACTION_CLEAR_FILTERS}" Style="{StaticResource SidebarLinkButton}" Command="{Binding ClearFiltersCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Margin="0,0,0,16">
                    <TabItem Header="Items">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="{extensions:TranslateExtension SECTION_CONNECTIONS_EXPENSES}" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                                    <ListView ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense, Mode=TwoWay}" ItemTemplate="{StaticResource SummaryItemTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{extensions:TranslateExtension SECTION_CONNECTIONS_RECEIPTS}" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                                    <ListView ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt, Mode=TwoWay}" ItemTemplate="{StaticResource SummaryItemTemplate}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Linked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="{extensions:TranslateExtension SECTION_CONNECTIONS_EXPENSE_LINKS}" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                                    <ListView ItemsSource="{Binding ExpenseLinks}" SelectedItem="{Binding SelectedExpenseLink, Mode=TwoWay}" ItemTemplate="{StaticResource DetailItemTemplate}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{extensions:TranslateExtension SECTION_CONNECTIONS_RECEIPT_LINKS}" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                                    <ListView ItemsSource="{Binding ReceiptLinks}" SelectedItem="{Binding SelectedReceiptLink, Mode=TwoWay}" ItemTemplate="{StaticResource DetailItemTemplate}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{extensions:TranslateExtension SECTION_CONNECTIONS_LINK_FORM}" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                        <TextBlock>
                            <Run Text="{extensions:TranslateExtension CONNECTIONS_SELECTED_EXPENSE}" />
                            <Run Text=": " />
                            <Run Text="{Binding SelectedExpense.Title, TargetNullValue='-'}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="{extensions:TranslateExtension CONNECTIONS_SELECTED_RECEIPT}" />
                            <Run Text=": " />
                            <Run Text="{Binding SelectedReceipt.Title, TargetNullValue='-'}" />
                        </TextBlock>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{extensions:TranslateExtension LABEL_NOTES}" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding Notes}" MinWidth="220" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{extensions:TranslateExtension ACTION_LINK_SELECTED}" Style="{StaticResource AccentButton}" Command="{Binding CreateLinkCommand}" Margin="0,0,12,0" />
                            <Button Content="{extensions:TranslateExtension ACTION_UPDATE_LINK}" Style="{StaticResource SidebarLinkButton}" Command="{Binding UpdateLinkCommand}" Margin="0,0,12,0" />
                            <Button Content="{extensions:TranslateExtension ACTION_DELETE_LINK}" Style="{StaticResource SidebarLinkButton}" Command="{Binding DeleteLinkCommand}" Margin="0,0,12,0" />
                            <Button Content="{extensions:TranslateExtension ACTION_CLEAR_SELECTION}" Style="{StaticResource SidebarLinkButton}" Command="{Binding ResetLinkFormCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" Padding="24" CornerRadius="12">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                    <TextBlock Text="{extensions:TranslateExtension STATUS_LOADING_CONNECTIONS}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <Border Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" Padding="24" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="{extensions:TranslateExtension ERROR_DATA_LOAD}" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
